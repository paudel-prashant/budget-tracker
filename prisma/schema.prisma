generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CategoryRuleMatch {
  CONTAINS
  STARTS_WITH
  EXACT
}

enum FinanceAccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT
  /// TFSA, RRSP, brokerage — counts toward net worth but not spendable cash.
  INVESTMENT
  OTHER
}

model User {
  id                     String                 @id @default(cuid())
  name                   String?
  email                  String?                @unique
  emailVerified          DateTime?
  image                  String?
  preferredCurrency      String                 @default("CAD")
  /// Start each month with the most recent month's budgets when it has none.
  budgetCarryOverEnabled Boolean                @default(true)
  /// "YYYY-MM" of the last month carry-over ran for, so it runs at most once per month
  /// (a user who deletes a carried-over budget doesn't get it recreated).
  budgetCarryOverMonth   String?
  budgetAlertsEnabled    Boolean                @default(true)
  accounts               Account[]
  sessions               Session[]
  transactions           Transaction[]
  budgets                Budget[]
  recurringTransactions  RecurringTransaction[]
  categoryMappings       CategoryMapping[]
  assets                 Asset[]
  liabilities            Liability[]
  netWorthSnapshots      NetWorthSnapshot[]
  dashboardLayout        DashboardLayout?
  financeAccounts        FinanceAccount[]
  goals                  Goal[]
  transfers              Transfer[]
  pushSubscriptions      PushSubscription[]
  categoryRules          CategoryRule[]
  dismissedSuggestions   DismissedSuggestion[]
}

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  widgets   Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Transaction {
  id                     String                @id @default(cuid())
  title                  String
  amount                 Float
  currency               String                @default("CAD")
  baseAmount             Float
  type                   TransactionType
  category               String
  date                   DateTime
  tags                   String[]              @default([])
  createdAt              DateTime              @default(now())
  userId                 String
  financeAccountId       String?
  recurringTransactionId String?
  occurrenceDate         DateTime?
  importHash             String?
  /// Shared by the rows of a split transaction (one purchase spread across categories).
  splitGroupId           String?
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  financeAccount         FinanceAccount?       @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@unique([recurringTransactionId, occurrenceDate])
  @@unique([userId, importHash])
  @@index([userId, date(sort: Desc)])
  @@index([userId, type])
  @@index([userId, category])
  @@index([financeAccountId])
  @@index([splitGroupId])
}

model FinanceAccount {
  id             String             @id @default(cuid())
  userId         String
  name           String
  type           FinanceAccountType @default(CHECKING)
  /// Balance before any recorded transaction; currentBalance is derived from this.
  openingBalance Float              @default(0)
  /// Credit cards only: the provider's limit, for utilization.
  creditLimit    Float?
  currentBalance Float              @default(0)
  currency       String             @default("CAD")
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  transfersOut   Transfer[]         @relation("TransferFrom")
  transfersIn    Transfer[]         @relation("TransferTo")

  @@index([userId])
}

/// Money moved between two of the user's accounts. Deliberately not a Transaction:
/// transfers change account balances but are neither income nor spending.
model Transfer {
  id            String         @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Float
  date          DateTime
  note          String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   FinanceAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     FinanceAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model RecurringTransaction {
  id              String              @id @default(cuid())
  title           String
  amount          Float
  type            TransactionType
  category        String
  frequency       RecurrenceFrequency
  startDate       DateTime
  endDate         DateTime?
  lastProcessedAt DateTime?
  createdAt       DateTime            @default(now())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

model Budget {
  id              String           @id @default(cuid())
  category        String
  monthlyLimit    Float
  month           Int
  year            Int
  rolloverEnabled Boolean          @default(false)
  createdAt       DateTime         @default(now())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertLogs       BudgetAlertLog[]

  @@unique([userId, category, month, year])
}

/// One row per budget per threshold crossed, so each alert is only ever sent once.
model BudgetAlertLog {
  id        String   @id @default(cuid())
  budgetId  String
  threshold Int
  sentAt    DateTime @default(now())
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, threshold])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CategoryMapping {
  id        String          @id @default(cuid())
  userId    String
  titleKey  String
  category  String
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, titleKey, type])
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  value     Float
  asOfDate  DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, asOfDate(sort: Desc)])
}

model Liability {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  value     Float
  asOfDate  DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, asOfDate(sort: Desc)])
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  month            String
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float
  monthlyIncome    Float    @default(0)
  monthlyExpenses  Float    @default(0)
  monthlySavings   Float    @default(0)
  savingsRate      Float?
  recordedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  category      String?
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// User-defined categorization rule ("titles containing UBER -> Transport, tag: work").
/// Rules beat learned mappings and imported CSV categories. pattern is stored
/// normalized (normalizeTitleKey) so matching ignores case and punctuation.
model CategoryRule {
  id        String            @id @default(cuid())
  userId    String
  pattern   String
  matchType CategoryRuleMatch @default(CONTAINS)
  /// null = applies to both income and expenses.
  type      TransactionType?
  category  String
  tags      String[]          @default([])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Suggestions the user dismissed (e.g. a detected subscription), keyed by a stable
/// string such as "subscription:netflix" so they don't reappear.
model DismissedSuggestion {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
